{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pre-commit": {
    "enabled": true
  },
  "baseBranchPatterns": [
    "develop",
    "next"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Kubernetes version of the JSON schemas referenced in the values schema source. The yannh/kubernetes-json-schema repository has no version tags, its folders follow the Kubernetes releases.",
      "managerFilePatterns": [
        "/^charts/nautobot/schema/values\\.schema\\.json$/"
      ],
      "matchStrings": [
        "yannh/kubernetes-json-schema/master/(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes-json-schema",
      "packageNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Disable python updates in the develop branch.",
      "matchBaseBranches": [
        "develop"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Disable minor and major updates in the develop branch.",
      "matchBaseBranches": [
        "develop"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Allow minor and major pre-commit and GitHub updates in the develop branch.",
      "matchBaseBranches": [
        "develop"
      ],
      "matchFileNames": [
        ".pre-commit-config.yaml",
        ".github/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "schedule": [
        "before 3am on Monday"
      ],
      "enabled": true
    },
    {
      "description": "Weekly patch updates in the develop and next branch.",
      "matchBaseBranches": [
        "develop",
        "next"
      ],
      "matchPackageNames": [
        "!python"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Patch Updates",
      "schedule": [
        "before 3am on Monday"
      ],
      "enabled": true
    },
    {
      "description": "Monthly major updates in the next branch.",
      "matchBaseBranches": [
        "next"
      ],
      "matchPackageNames": [
        "!python"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "before 3am on the first day of the month"
      ],
      "enabled": true
    },
    {
      "description": "Bi-weekly minor updates in the next branch.",
      "matchBaseBranches": [
        "next"
      ],
      "matchPackageNames": [
        "!python"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Minor Updates",
      "schedule": [
        "before 3am every 2 weeks on Monday"
      ],
      "enabled": true
    },
    {
      "description": "Disable pre-commit and GitHub updates in the next branch, they go to develop.",
      "matchBaseBranches": [
        "next"
      ],
      "matchFileNames": [
        ".pre-commit-config.yaml",
        ".github/**"
      ],
      "enabled": false
    },
    {
      "description": "Separate PR every 3 months for the Kubernetes JSON schema version, it changes values validation. The schema folder is published a day or two after the Kubernetes release.",
      "matchDepNames": [
        "kubernetes-json-schema"
      ],
      "groupName": "Kubernetes JSON Schemas",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "* * 1 */3 *"
      ]
    }
  ]
}
